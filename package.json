{
  "name": "moto-ride",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src docs *.ts *.js *.json *.md .env.example index.html --ignore-unknown",
    "docker:up": "sh scripts/docker.sh up",
    "docker:down": "sh scripts/docker.sh down",
    "docker:status": "sh scripts/docker.sh status",
    "docker:logs": "sh scripts/docker.sh logs"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.40",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
